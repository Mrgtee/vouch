{
  "name": "vouch",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Vouch is an OKX.AI-ready career workflow ASP that benchmarks resumes against target jobs and returns an evidence-backed application packet.",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "okx:run": "node scripts/okx-run.mjs --",
    "okx:chains": "node scripts/okx-run.mjs -- onchainos wallet chains",
    "okx:agents": "node scripts/okx-run.mjs -- onchainos agent get-my-agents"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@okxweb3/x402-core": "^0.1.0",
    "@okxweb3/x402-evm": "^0.2.1",
    "@okxweb3/x402-express": "^0.1.1",
    "express": "^5.2.1",
    "openai": "^6.48.0"
  }
}
