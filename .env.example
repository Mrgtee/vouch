PORT=3000
VOUCH_PUBLIC_BASE_URL=https://YOUR_DEPLOYED_DOMAIN

# Production default. Use free only for local development checks.
VOUCH_PAYMENT_MODE=paid
VOUCH_PRICE_USD=0.20
VOUCH_ENABLE_URL_FETCH=true

# Production security controls. Keep OKX origins if the marketplace UI calls from a browser.
VOUCH_TRUST_PROXY=1
VOUCH_ALLOWED_ORIGINS=https://YOUR_DEPLOYED_DOMAIN,https://www.okx.com,https://web3.okx.com,https://app.okx.com
VOUCH_FRAME_ANCESTORS=self,https://okx.com,https://*.okx.com
VOUCH_RATE_LIMIT_ENABLED=true
VOUCH_RATE_LIMIT_WINDOW_MS=60000
VOUCH_RATE_LIMIT_PUBLIC_MAX=120
VOUCH_RATE_LIMIT_PACKET_MAX=30

# Emergency fallback only. Leave false for normal paid production.
VOUCH_ALLOW_LOCAL_AI_IN_PAID=false

# OKX x402 seller payment config.
# PAY_TO_ADDRESS must be your EVM-compatible receiving wallet on X Layer.
PAY_TO_ADDRESS=0xYourXLayerReceivingWallet
OKX_API_KEY=your_okx_developer_api_key
OKX_SECRET_KEY=your_okx_developer_secret_key
OKX_PASSPHRASE=your_okx_developer_passphrase
OKX_BASE_URL=https://web3.okx.com
VOUCH_SYNC_SETTLE=true

# OpenAI packet generation. Production default is openai.
VOUCH_AI_PROVIDER=openai
VOUCH_OPENAI_MODEL=gpt-5
OPENAI_API_KEY=sk-your_openai_api_key
VOUCH_OPENAI_TIMEOUT_MS=20000
VOUCH_OPENAI_MAX_OUTPUT_TOKENS=7000
